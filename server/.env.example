# ============================================================
#  在这里填写你的 API Key（复制本文件为 .env 后填写，.env 已被 git 忽略）
# ============================================================

# DeepSeek 开放平台：https://platform.deepseek.com/ -> API Keys
DEEPSEEK_API_KEY=

# Kimi(Moonshot) 开放平台：https://platform.moonshot.cn/ -> API Key 管理
MOONSHOT_API_KEY=

# 代理服务端口（可选，默认 3001）
PORT=3001